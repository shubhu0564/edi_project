# ResolveX backend — example environment configuration.
# Copy to .env and fill in real values. Never commit the real .env.

# HTTP server
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS (optional; defaults to http://localhost:3000)
CLIENT_URL=http://localhost:3000

# MongoDB connection string (placeholder — use your own cluster/URI)
MONGO_URI=mongodb://localhost:27017/resolvex

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# Escalation scheduler (STEP 6)
# Interval between due-escalation checks, in milliseconds. Default: 60000 (60s).
ESCALATION_INTERVAL_MS=60000
# Set to "off" to disable the automatic scheduler (engine still runs on demand).
# ESCALATION_SCHEDULER=off
